{
  "name": "pi-research-scientist",
  "version": "0.1.0",
  "description": "A readable research-engineering harness for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "research",
    "ml",
    "reproducibility"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "prompts",
    "templates",
    "scripts",
    "tests",
    "examples",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/research-guardrails/index.ts",
      "./extensions/scholarly/index.ts",
      "./extensions/zotero/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-package.ts",
    "smoke": "node scripts/smoke-pi.ts",
    "pack:check": "node scripts/check-pack.ts",
    "test:live": "node scripts/check-live-scholarly.ts",
    "init-project": "node scripts/init-project.ts",
    "check": "npm test && npm run typecheck && npm run validate && npm run smoke && npm run pack:check"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.19",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
